{
  "name": "onod-fonts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "metadata:runtime": "node scripts/build-runtime-metadata.mjs",
    "predev": "npm run metadata:runtime",
    "dev": "vite",
    "pretypecheck": "npm run metadata:runtime",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run metadata:runtime",
    "build": "vite build",
    "preview": "vite preview",
    "fontshare:evidence:validate": "node --experimental-strip-types scripts/validate-fontshare-evidence.mjs --require-coverage",
    "independent:evidence:validate": "node --experimental-strip-types scripts/validate-independent-sources.mjs",
    "catalog:validate": "npm run metadata:runtime && node --experimental-strip-types scripts/validate-catalog.mjs",
    "build:validate": "node scripts/validate-build.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "check": "npm run metadata:runtime && node --experimental-strip-types scripts/validate-fontshare-evidence.mjs --require-coverage && node --experimental-strip-types scripts/validate-independent-sources.mjs && node --experimental-strip-types scripts/validate-catalog.mjs && tsc --noEmit && vite build && node scripts/validate-build.mjs && node scripts/smoke-preview.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "22.20.1",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
